# Production environment template.
# Copy this to services/api/.env on the production server — do NOT commit .env itself.
# Generate SECRET_KEY with: openssl rand -hex 32

# --- App ---
APP_ENV=production
APP_NAME=Artemis API
SECRET_KEY=<generate with: openssl rand -hex 32>

# --- Database ---
DATABASE_URL=postgresql://user:pass@rds-host:5432/artemis

# --- Redis ---
REDIS_URL=redis://redis-host:6379/0

# --- Storage ---
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_REGION=us-east-1
S3_BUCKET_NAME=artemis-resumes-prod
S3_KEY_PREFIX=resumes

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI ---
OPENAI_API_KEY=<your-openai-api-key>

# --- Email ---
EMAIL_BACKEND=sendgrid
SENDGRID_API_KEY=<your-sendgrid-api-key>
FROM_EMAIL=noreply@artemis.dev

# --- Error Tracking ---
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=production

# --- Feature Flags ---
ENABLE_RESUME_PARSER=true
ENABLE_AUTOMATION=true
