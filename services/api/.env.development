# Local development defaults — safe to commit, no real secrets.
# Copy this to services/api/.env to run the API locally.

# --- App ---
APP_ENV=development
APP_NAME=Artemis API (dev)
SECRET_KEY=dev_secret_key_change_before_staging

# --- Database ---
DATABASE_URL=postgresql://artemis:artemis@localhost:5433/artemis

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_KEY_PREFIX=resumes

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI ---
OPENAI_API_KEY=

# --- Email ---
EMAIL_BACKEND=console
SENDGRID_API_KEY=
FROM_EMAIL=noreply@artemis.dev

# --- Error Tracking ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Feature Flags ---
ENABLE_RESUME_PARSER=true
ENABLE_AUTOMATION=true
