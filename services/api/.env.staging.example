# Staging environment template.
# Copy this to services/api/.env on the staging server — do NOT commit .env itself.
# Generate SECRET_KEY with: openssl rand -hex 32

# --- App ---
APP_ENV=staging
APP_NAME=Artemis API (staging)
SECRET_KEY=<generate with: openssl rand -hex 32>

# --- Database ---
DATABASE_URL=postgresql://user:pass@rds-host:5432/artemis

# --- Redis ---
REDIS_URL=redis://redis-host:6379/0

# --- Storage ---
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_REGION=us-east-1
S3_BUCKET_NAME=artemis-resumes-staging
S3_KEY_PREFIX=resumes

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Groq (LLM) ---
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email ---
EMAIL_BACKEND=sendgrid
SENDGRID_API_KEY=<your-sendgrid-api-key>
FROM_EMAIL=noreply@artemis.dev

# --- Error Tracking ---
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=staging

# --- Feature Flags ---
ENABLE_RESUME_PARSER=true
ENABLE_AUTOMATION=true
MAX_PIPELINE_RETRIES=3

# --- Worker Scheduling ---
# How often Celery beat triggers feed scans for all users.
JOB_SCAN_INTERVAL_HOURS=24
