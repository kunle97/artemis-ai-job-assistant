# Environment variable index — high-level reference only.
# Each service manages its own env files. See:
#   services/api/.env.example          ← API variables
#   services/api/.env.development      ← safe local defaults for the API
#   services/api/.env.staging.example  ← staging template for the API
#   services/api/.env.production.example ← production template for the API
#
#   services/web/.env.example          ← web variables
#   services/web/.env.development      ← safe local defaults for the web app
#   services/web/.env.staging.example  ← staging template for the web app
#   services/web/.env.production.example ← production template for the web app
#
# Quick start (local dev):
#   cp services/api/.env.development services/api/.env
#   cp services/web/.env.development services/web/.env.local

# Worker schedule used by Docker Compose (hours between feed scans).
JOB_SCAN_INTERVAL_HOURS=24